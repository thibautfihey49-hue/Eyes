<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#121212"
    android:padding="20dp"
    android:gravity="center_horizontal">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="👁️ EYES"
        android:textSize="28sp"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="30dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1E3A1E"
        android:orientation="vertical"
        android:padding="20dp"
        android:layout_marginBottom="20dp"
        android:gravity="center"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TON ID UNIQUE"
            android:textSize="14sp"
            android:textColor="#AAAAAA"/>

        <TextView
            android:id="@+id/tvMyId"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="---- ----"
            android:textSize="22sp"
            android:textColor="#4CAF50"
            android:fontFamily="monospace"
            android:layout_marginTop="8dp"/>
    </LinearLayout>

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="⏳ Arrêté"
        android:padding="15dp"
        android:gravity="center"
        android:background="#2A2A2A"
        android:textColor="#AAAAAA"
        android:textSize="15sp"
        android:layout_marginBottom="20dp"/>

    <Button
        android:id="@+id/btnStart"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="▶️ ACTIVER EYES"
        android:background="#2196F3"
        android:textColor="#FFFFFF"
        android:textSize="17sp"
        android:layout_marginBottom="10dp"/>

    <Button
        android:id="@+id/btnStop"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="⏹️ ARRÊTER"
        android:background="#E91E63"
        android:textColor="#FFFFFF"
        android:textSize="17sp"
        android:enabled="false"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🔋 Une fois activé, EYES tourne en arrière-plan même si tu fermes l'application.\nRedémarre automatiquement au démarrage du téléphone."
        android:textSize="12sp"
        android:textColor="#666666"
        android:gravity="center"
        android:layout_marginTop="20dp"/>

</LinearLayout>
