<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="20dp"
    android:gravity="center_horizontal" android:background="#121212">
    <TextView android:text="👁️ EYES" android:textSize="28sp" android:textStyle="bold"
        android:textColor="#FFFFFF" android:layout_marginBottom="5dp"/>
    <TextView android:id="@+id/tvMyId" android:text="🔗 MON ID : -----"
        android:textSize="18sp" android:textColor="#4CAF50" android:layout_marginBottom="20dp"/>
    <TextView android:text="🔗 ID DE LA CIBLE :" android:textColor="#CCCCCC" android:textSize="16sp"/>
    <EditText android:id="@+id/etTargetId" android:layout_width="250dp" android:layout_height="50dp"
        android:hint="ex: ABCD-1234" android:textColor="#FFFFFF" android:background="#333333"
        android:padding="10dp" android:layout_marginBottom="15dp" android:gravity="center"/>
    <Button android:id="@+id/btnConnect" android:layout_width="250dp" android:layout_height="60dp"
        android:text="▶️ VOIR EN DIRECT" android:background="#2196F3" android:textColor="#FFFFFF"
        android:textSize="18sp" android:layout_marginBottom="10dp"/>
    <Button android:id="@+id/btnDisconnect" android:layout_width="250dp" android:layout_height="50dp"
        android:text="⏹️ ARRÊTER" android:background="#E91E63" android:textColor="#FFFFFF"
        android:layout_marginBottom="15dp"/>
    <TextView android:id="@+id/tvStatus" android:text="Statut : En attente"
        android:textColor="#AAAAAA" android:layout_marginBottom="15dp"/>
    <ImageView android:id="@+id/ivVideo" android:layout_width="match_parent" android:layout_height="300dp"
        android:background="#1A1A1A" android:scaleType="fitCenter"/>
    <TextView android:text="🔒 P2P direct — Ta caméra ne s'allume JAMAIS du côté visionneur"
        android:textColor="#666666" android:textSize="12sp" android:layout_marginTop="15dp"/>
</LinearLayout>
